diff --git a/netlab3.3/pmtkNetlabFunction.m b/netlab3.3/pmtkNetlabFunction.m
new file mode 100644
--- /dev/null
+++ b/netlab3.3/pmtkNetlabFunction.m
@@ -0,0 +1,17 @@
+function fun = pmtkNetlabFunction(fun, varargin)
+if exist('OCTAVE_VERSION', 'builtin') == 0
+    fun = fcnchk(fun, varargin{:});
+    return;
+end
+if ischar(fun)
+    fun = strtrim(fun);
+    if strncmp(fun, '@', 1) || ~isempty(regexp(fun, '^[A-Za-z]\w*(\.[A-Za-z]\w*)*$', 'once'))
+        fun = str2func(fun);
+    else
+        fun = inline(fun, varargin{:});
+    end
+end
+if ~isa(fun, 'function_handle') && ~isa(fun, 'inline')
+    error('PMTK:InvalidNetlabFunction', 'Expected a function handle, inline object, function name or expression.');
+end
+end
